# Nothing here is required. With no variables set, scripts/db.py starts its
# own throwaway Postgres container and talks to it through "docker exec".
# This file is documentation: the scripts read the process environment and do
# not load a .env file, so export the values you want in your shell.

# Docker mode (default)
RLS_COOKBOOK_CONTAINER=rls-cookbook-pg
RLS_COOKBOOK_IMAGE=postgres:16
RLS_COOKBOOK_PG_MAJOR=16

# psql mode: set PGHOST to use an existing server instead of Docker.
# The server needs the pgTAP extension files and a role that may create
# databases and roles. These are throwaway local values, not secrets.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
